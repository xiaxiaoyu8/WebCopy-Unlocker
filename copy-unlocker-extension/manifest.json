{
  "manifest_version": 3,
  "name": "Copy Unlocker",
  "version": "1.0.0",
  "description": "Unlock page copy, selection, paste, and context menu restrictions on demand.",
  "permissions": ["activeTab", "scripting"],
  "icons": {
    "16": "icons/gray-16.png",
    "32": "icons/gray-32.png",
    "48": "icons/gray-48.png",
    "128": "icons/gray-128.png"
  },
  "action": {
    "default_title": "解除复制限制",
    "default_icon": {
      "16": "icons/gray-16.png",
      "32": "icons/gray-32.png",
      "48": "icons/gray-48.png",
      "128": "icons/gray-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}
